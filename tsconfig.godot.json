{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "types": [
      "react"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@godot-fabric/runtime": ["./types/godot-fabric.ts"],
      "react-native": [
        "./types/react-native.ts"
      ]
    },
    "moduleSuffixes": [
      ".godot",
      ".native",
      ""
    ]
  },
  "include": [
    "consumers/civ-lite/ui/**/*.ts",
    "consumers/civ-lite/ui/**/*.tsx",
    "examples/form/**/*.tsx",
    "tests/types/**/*.tsx"
  ]
}
