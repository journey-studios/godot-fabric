# Raw per-run reports are regenerated by every check into build/ and kept as CI
# artifacts. Versioned evidence is the curated record beside them: README,
# matrix.json, provenance.json and captures.
docs/evidence/**/*-report.json
docs/evidence/examples/*-headless.json
docs/evidence/examples/*-native.json
docs/evidence/public-controls/*-headless.json
docs/evidence/public-controls/*-native.json
