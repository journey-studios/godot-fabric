+func capture_window(window: Window, path: String) -> Dictionary:
+  if window == null or not is_instance_valid(window): return {"saved": false, "reason": "missing Modal Window"}
+  await RenderingServer.frame_post_draw
+  var texture: ViewportTexture = window.get_texture()
+  if texture == null: return {"saved": false, "reason": "missing viewport texture"}
+  var image: Image = texture.get_image()
+  if image == null or image.is_empty(): return {"saved": false, "reason": "empty viewport image"}
+  var error := image.save_png(path)
+  return {"saved": error == OK, "path": path, "error": error, "width": image.get_width(), "height": image.get_height()}
+
