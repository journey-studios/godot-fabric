  "rule": {
    "definition": "planar_violation in native/affine_transform.h: None, ZCoupling (any of matrix[2], [3], [6], [7], [8], [9], [11], [14] nonzero) or Weight (matrix[15] != 1), in that order",
    "freeEntry": "matrix[10]: with every z-coupling entry zero it only multiplies z, and a Control's points have z = 0",
    "whyIndex10IsFree": "RN writes scale n as scale3d(n, n, n) (Transform::Scale sets matrix[0], [5] and [10]); iOS copies all 16 entries to the layer's CATransform3D and Android applies scale[0] and scale[1] as scaleX and scaleY, both in the plane",
    "users": {
      "affine_factors": "E_TRANSFORM_3D, with 'perspective and 3D transforms are not implemented' for ZCoupling and 'expected a planar affine transform' for Weight",
      "local_transform": "E_POINTER_GEOMETRY_3D"
    },
    "stillRejected": [
      "singular matrices, scale: 0 included (E_TRANSFORM_SINGULAR)",
      "every z-coupling entry (rotateX, rotateY, perspective)",
      "matrix[15] != 1",
      "nonfinite entries",
      "results or inverses outside native coordinate precision"
    ],
    "newPublicRejectionCases": {
      "rotate-x": "rotateX 30deg: z coupling at matrix[6] and [9]",
      "w-not-one": "matrix with matrix[15] = 2"
    }
  },
