{
  "name": "godot-fabric",
  "private": true,
  "scripts": {
    "dashboard": "node scripts/migration-dashboard.mjs",
    "dashboard:build": "node scripts/build-dashboard-pages.mjs",
    "dashboard:check": "node scripts/migration-dashboard.mjs check",
    "dashboard:sync": "node scripts/migration-dashboard.mjs sync",
    "test:dashboard": "node --test tests/migration-dashboard.test.mjs",
    "bundle": "node scripts/bundle.mjs",
    "setup": "python3 scripts/setup.py",
    "check": "node scripts/check.mjs",
    "check:static": "fallow dead-code --root . --config .fallowrc.json",
    "test:recovery": "python3 -m unittest discover -s tests -p '*_test.py' && node --test tests/godot-binary.test.mjs tests/recovery.test.mjs",
    "test:charts": "node --test tests/svg-contract.test.mjs tests/chart-native.test.mjs",
    "test:nativewind": "npm run bundle && node --test tests/nativewind-contract.test.mjs",
    "start": "node scripts/check.mjs --interactive",
    "test:typography": "npm run bundle && node --test tests/typography-contract.test.mjs tests/typography-native.test.mjs tests/line-height-native.test.mjs",
    "test:contracts": "npm run bundle && npm run type-check && npm run test:parity && npm run test:dashboard && node --test tests/godot-binary.test.mjs tests/nativewind-contract.test.mjs tests/svg-contract.test.mjs tests/typography-contract.test.mjs tests/publication-scan.test.mjs tests/examples.test.mjs tests/control-contracts.test.mjs tests/godot-fabric.test.mjs tests/codegen.test.mjs tests/adapter-plugin.test.mjs tests/adapter-manifest.test.mjs tests/native-sdk.test.mjs tests/pack-addon-native.test.mjs tests/rn-pointer-overlay.test.mjs tests/rn-event-target-overlay.test.mjs tests/rn-pointer-interest-overlay.test.mjs tests/rn-renderer-tag-overlay.test.mjs tests/bundle-determinism.test.mjs tests/project-resolution.test.mjs tests/package-conditions.test.mjs tests/platform-seams.test.mjs && python3 -m unittest discover -s tests -p \"*_test.py\"",
    "check:publication": "node scripts/publication-scan.mjs",
    "test:cold": "npm run bundle && node scripts/cold-start.mjs",
    "parity:inventory": "node scripts/parity-inventory.mjs",
    "parity:status": "node scripts/parity-status.mjs",
    "parity:godot": "node scripts/parity-godot.mjs",
    "parity:ios": "node scripts/parity-reference.mjs --platform ios",
    "parity:android": "node scripts/parity-reference.mjs --platform android",
    "parity:compare": "node scripts/parity-compare.mjs",
    "test:parity": "node scripts/parity-inventory.mjs --check && node --test tests/parity-inventory.test.mjs tests/parity-protocol.test.mjs tests/reference-cleanup.test.mjs",
    "example": "node scripts/examples.mjs",
    "examples:list": "node scripts/examples.mjs --list",
    "test:examples": "node scripts/examples-check.mjs",
    "test:runtime": "npm run bundle && node --test tests/runtime-native.test.mjs",
    "test:application": "npm run bundle && node --test tests/shared-application-native.test.mjs",
    "test:modules": "npm run bundle && node --test tests/native-modules-native.test.mjs tests/metrics-errors-native.test.mjs",
    "type-check": "tsc -p tsconfig.godot.json",
    "sdk:pack": "node scripts/pack-addon.mjs",
    "consumer:create": "node scripts/create-consumer.mjs",
    "test:consumer": "node scripts/consumer-check.mjs",
    "test:services": "npm run bundle && node --test --test-concurrency=1 tests/services-boundaries-native.test.mjs tests/services-lifetime-native.test.mjs",
    "test:codegen": "node --test tests/codegen.test.mjs",
    "test:codegen:native": "python3 scripts/codegen-native-compile.py --out build/codegen-native-compile",
    "sdk:native:pack": "node scripts/native-sdk.mjs pack",
    "sdk:native:verify": "node scripts/native-sdk.mjs verify",
    "test:adapters": "node --test tests/adapter-plugin.test.mjs tests/adapter-manifest.test.mjs tests/native-sdk.test.mjs",
    "test:adapters:native": "node scripts/adapter-registry-check.mjs",
    "test:adapters:loader": "node scripts/adapter-loader-check.mjs",
    "test:adapters:runtime": "node scripts/adapter-runtime-check.mjs",
    "test:transforms:guards": "node scripts/transform-guards-check.mjs",
    "test:focus:commands": "node --test tests/focus-commands-native.test.mjs",
    "test:pointers:processor": "node --test --test-concurrency=1 tests/pointer-processor-native.test.mjs tests/pointer-errors-native.test.mjs",
    "test:pointers:geometry": "node --test --test-concurrency=1 tests/pointer-geometry-native.test.mjs tests/pointer-projection-native.test.mjs",
    "test:events:original": "node --test tests/event-target-native.test.mjs",
    "test:events:ancestry": "node --test tests/event-target-ancestry-native.test.mjs",
    "test:events:dispatch": "node --test tests/event-dispatch-native.test.mjs",
    "test:events:integrated": "node --test tests/event-dispatch-integrated-native.test.mjs",
    "test:pointers:interest": "node --test tests/pointer-interest-native.test.mjs",
    "test:pointers:query-faults": "node --test tests/pointer-query-fault-native.test.mjs",
    "test:pointers:documents": "node --test tests/pointer-document-native.test.mjs",
    "test:pointers:resolver-faults": "node --test tests/pointer-resolver-fault-native.test.mjs",
    "test:pointers:up": "node --test tests/pointer-up-native.test.mjs",
    "test:pointers:move": "node --test tests/pointer-move-native.test.mjs",
    "test:pointers:documents:up": "node --test tests/pointer-document-up-native.test.mjs",
    "test:pointers:documents:move": "node --test tests/pointer-document-move-native.test.mjs",
    "test:pointers:hover": "node --test tests/pointer-hover-native.test.mjs",
    "test:pointers:root-path": "node --test tests/pointer-root-path-native.test.mjs",
    "test:pointers:documents:hover": "node --test tests/pointer-document-hover-native.test.mjs",
    "test:pointers:click": "node --test tests/pointer-click-native.test.mjs",
    "test:responders:pan": "node --test tests/pan-responder-native.test.mjs",
    "test:app-state": "node --test tests/app-state-native.test.mjs",
    "test:switch": "node --test tests/switch-native.test.mjs"
  },
  "dependencies": {
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-chart-kit": "7.0.4",
    "react-native-css-interop": "0.2.7",
    "react-native-svg": "15.15.5",
    "scheduler": "0.27.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/codegen": "0.87.1",
    "@types/react": "19.2.3",
    "esbuild": "0.25.12",
    "fallow": "3.18.0",
    "jscpd": "5.4.0",
    "metro-resolver": "0.87.1",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3"
  },
  "version": "0.1.0",
  "description": "An experimental React renderer for Godot, powered by React Native Fabric and Hermes",
  "repository": {
    "type": "git",
    "url": "https://github.com/journey-studios/godot-fabric.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
