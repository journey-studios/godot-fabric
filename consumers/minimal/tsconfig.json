{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "react": ["./addons/godot_fabric/toolchain/node_modules/@types/react"],
      "react/*": ["./addons/godot_fabric/toolchain/node_modules/@types/react/*"],
      "react-native": ["./addons/godot_fabric/types/react-native.ts"]
    },
    "moduleSuffixes": [".godot", ".native", ""]
  },
  "include": ["ui/**/*.ts", "ui/**/*.tsx"]
}
