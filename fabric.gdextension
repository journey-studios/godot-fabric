[configuration]
entry_symbol = "fabric_library_init"
compatibility_minimum = "4.7.2"
reloadable = false

[libraries]
macos.debug.arm64 = "res://addons/fabric_godot.dylib"
macos.release.arm64 = "res://addons/fabric_godot.dylib"
ios.release.arm64 = "res://addons/ios/godot_fabric.release.xcframework"
ios.release.x86_64 = "res://addons/ios/godot_fabric.release.x86_64-simulator.xcframework"
