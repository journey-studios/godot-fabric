{
  "$schema": "node_modules/fallow/schema.json",
  "entry": [
    "dashboard/app.mjs",
    "dashboard/style.css",
    "examples/entry.jsx",
    "src/initialize.js",
    "src/private-interface.js",
    "src/platform.js",
    "src/native-modules.js",
    "src/ui-manager.js",
    "src/react-native-platform.jsx",
    "src/render-application.jsx",
    "src/svg.jsx",
    "src/unsupported-reanimated.js",
    "src/unsupported-safe-area.js",
    "types/react-native.ts",
    "tests/types/consumer.tsx",
    "consumers/minimal/ui/index.tsx",
    "src/renderer-proxy.js",
    "src/godot-fabric.js",
    "types/godot-fabric.ts",
    "tests/types/godot-fabric.tsx",
    "tests/adapters/consumer/ui/index.tsx",
    "tests/focus-command-fixture.jsx",
    "tests/pointer-errors-fixture.jsx",
    "tests/event-target-fixture.jsx",
    "tests/event-target-ancestry-fixture.jsx",
    "tests/event-dispatch-fixture.jsx",
    "tests/event-dispatch-integrated-fixture.jsx",
    "tests/pointer-interest-fixture.jsx",
    "tests/pointer-query-fault-fixture.jsx",
    "tests/pointer-document-fixture.jsx",
    "tests/pointer-resolver-fault-fixture.jsx",
    "tests/pointer-up-fixture.jsx",
    "tests/pointer-move-fixture.jsx",
    "tests/pointer-document-move-fixture.jsx",
    "tests/pointer-hover-fixture.jsx",
    "tests/pointer-root-path-fixture.jsx",
    "tests/pointer-document-hover-fixture.jsx",
    "tests/pointer-click-fixture.jsx",
    "tests/pan-responder-fixture.jsx",
    "tests/pointer-document-up-fixture.jsx",
    "tests/app-state-fixture.jsx",
    "tests/virtualized-list-fixture.jsx",
    "tests/switch-fixture.jsx",
    "tests/shared-touches-fixture.jsx",
    "tests/touchables-fixture.jsx",
    "tests/touchables-animated-fixture.jsx"
  ],
  "ignorePatterns": [
    "build/**",
    "addons/**",
    "evidence/**",
    ".deps/**",
    "consumers/minimal/ui/platform.native.ts"
  ],
  "includeEntryExports": true,
  "ignoreDependencies": [
    "scheduler",
    "@godot-fabric/adapter-fixture"
  ],
  "ignoreExports": [
    {
      "file": "src/render-application.jsx",
      "exports": [
        "default"
      ]
    },
    {
      "file": "src/private-interface.js",
      "exports": [
        "ReactNativeViewConfigRegistry",
        "RawEventEmitter",
        "createAttributePayload",
        "diffAttributePayloads",
        "createPublicInstance",
        "ReactFiberErrorDialog",
        "createPublicRootInstance",
        "createPublicTextInstance",
        "getNativeTagFromPublicInstance",
        "getNodeFromPublicInstance",
        "legacySendAccessibilityEvent",
        "UIManager",
        "getInternalInstanceHandleFromPublicInstance",
        "getInternalInstanceHandleFromNativeTag",
        "dispatchNativeEvent"
      ]
    },
    {
      "file": "src/platform.js",
      "exports": [
        "default"
      ]
    },
    {
      "file": "src/native-modules.js",
      "exports": [
        "default"
      ]
    },
    {
      "file": "src/ui-manager.js",
      "exports": [
        "default"
      ]
    },
    {
      "file": "src/svg.jsx",
      "exports": [
        "G",
        "Path",
        "Rect",
        "Circle",
        "Line",
        "Text",
        "Defs",
        "ClipPath",
        "LinearGradient",
        "Stop",
        "default"
      ]
    },
    {
      "file": "src/react-native-platform.jsx",
      "exports": [
        "useWindowDimensions",
        "Platform",
        "StyleSheet",
        "View",
        "Text",
        "ScrollView",
        "PanResponder",
        "useColorScheme",
        "Dimensions",
        "Appearance",
        "AppState",
        "AccessibilityInfo",
        "PixelRatio",
        "I18nManager",
        "Pressable",
        "Image",
        "Switch",
        "TouchableHighlight",
        "TouchableOpacity",
        "TouchableWithoutFeedback",
        "ActivityIndicator",
        "StatusBar",
        "FlatList",
        "SectionList",
        "VirtualizedSectionList",
        "RefreshControl",
        "ImageBackground",
        "KeyboardAvoidingView",
        "VirtualizedList",
        "TextInput",
        "Button",
        "AppRegistry",
        "RootTagContext",
        "findNodeHandle",
        "UIManager",
        "NativeModules",
        "NativeEventEmitter",
        "TurboModuleRegistry",
        "codegenNativeComponent",
        "codegenNativeCommands"
      ]
    },
    {
      "file": "tailwind.config.cjs",
      "exports": [
        "content",
        "presets",
        "corePlugins",
        "theme"
      ]
    },
    {
      "file": "src/renderer-proxy.js",
      "exports": [
        "dispatchCommand",
        "findHostInstance_DEPRECATED",
        "findNodeHandle",
        "sendAccessibilityEvent",
        "isChildPublicInstance",
        "getNodeFromInternalInstanceHandle",
        "getPublicInstanceFromInternalInstanceHandle",
        "getPublicInstanceFromRootTag"
      ]
    }
  ],
  "framework": [
    {
      "name": "fabric-godot-build",
      "enablers": [
        "esbuild"
      ],
      "entryPoints": [
        "scripts/*.mjs",
        "tailwind.config.cjs",
        "src/nativewind.css",
        "sdk/toolchain/*.mjs",
        "consumers/minimal/ui/platform.godot.ts"
      ],
      "entryPointRole": "support",
      "toolingDependencies": [
        "@react-native/babel-preset",
        "tailwindcss",
        "@babel/core"
      ],
      "usedExports": [
        {
          "pattern": "types/react-native.ts",
          "exports": [
            "View",
            "Text",
            "TextInput",
            "Button",
            "Switch",
            "SwitchChangeEvent",
            "StyleSheet",
            "AppRegistry",
            "RootTagContext",
            "NativeModules",
            "NativeEventEmitter",
            "TurboModuleRegistry",
            "TurboModule",
            "ViewInstance",
            "PointerEvent",
            "NativePointerEvent",
            "findNodeHandle",
            "UIManager",
            "EmitterSubscription",
            "HostComponent",
            "codegenNativeComponent",
            "codegenNativeCommands",
            "AppState",
            "AppStateStatus",
            "AppStateEvent",
            "FlatList",
            "SectionList",
            "VirtualizedList",
            "VirtualizedSectionList",
            "ListRenderItem",
            "SectionListData"
          ]
        },
        {
          "pattern": "consumers/minimal/ui/platform.godot.ts",
          "exports": [
            "platformMessage"
          ]
        },
        {
          "pattern": "types/godot-fabric.ts",
          "exports": [
            "GodotDTO",
            "ServiceAddress",
            "ServiceAcknowledgement",
            "ServiceSnapshot",
            "ServiceCallResult",
            "ServiceSubscription",
            "GodotFabric"
          ]
        },
        {
          "pattern": "src/godot-fabric.js",
          "exports": [
            "GodotFabric"
          ]
        }
      ]
    },
    {
      "name": "original-rn-codegen-specs",
      "enablers": [
        "@react-native/codegen"
      ],
      "entryPoints": [
        "tests/codegen/NativeCodegenProbe.ts",
        "tests/codegen/BadgeNativeComponent.ts",
        "tests/codegen/UnsupportedBadgeNativeComponent.ts",
        "tests/codegen/NativeFlowProbe.js",
        "tests/adapters/package/index.ts",
        "tests/adapters/package/BadgeNativeComponent.ts",
        "tests/adapters/package/NativeExternalProbe.ts"
      ],
      "entryPointRole": "support",
      "usedExports": [
        {
          "pattern": "tests/codegen/NativeCodegenProbe.ts",
          "exports": [
            "Spec",
            "ProbeResult",
            "default"
          ]
        },
        {
          "pattern": "tests/codegen/*NativeComponent.ts",
          "exports": [
            "NativeProps",
            "Commands",
            "default"
          ]
        },
        {
          "pattern": "tests/codegen/NativeFlowProbe.js",
          "exports": [
            "Spec",
            "default"
          ]
        },
        {
          "pattern": "tests/adapters/package/BadgeNativeComponent.ts",
          "exports": [
            "NativeProps",
            "Commands",
            "default"
          ]
        },
        {
          "pattern": "tests/adapters/package/NativeExternalProbe.ts",
          "exports": [
            "Spec",
            "default"
          ]
        },
        {
          "pattern": "tests/adapters/package/index.ts",
          "exports": [
            "Badge",
            "Commands",
            "Probe"
          ]
        }
      ]
    }
  ],
  "ignoreUnresolvedImports": [
    "@godot-fabric/runtime"
  ]
}
