{
  "$schema": "node_modules/fallow/schema.json",
  "entry": [
    "dashboard/app.mjs",
    "dashboard/style.css",
    "examples/entry.jsx",
    "src/initialize.js",
    "src/private-interface.js",
    "src/platform.js",
    "src/native-modules.js",
    "src/ui-manager.js",
    "src/react-native-platform.jsx",
    "src/render-application.jsx",
    "src/svg.jsx",
    "src/unsupported-reanimated.js",
    "src/unsupported-safe-area.js",
    "types/react-native.ts",
    "tests/types/consumer.tsx",
    "consumers/minimal/ui/index.tsx"
  ],
  "ignorePatterns": [
    "build/**",
    "addons/**",
    "evidence/**",
    ".deps/**",
    "consumers/minimal/ui/platform.native.ts"
  ],
  "includeEntryExports": true,
  "ignoreDependencies": [
    "scheduler"
  ],
  "ignoreExports": [
    {
      "file": "src/render-application.jsx",
      "exports": [
        "default"
      ]
    },
    {
      "file": "src/private-interface.js",
      "exports": [
        "ReactNativeViewConfigRegistry",
        "RawEventEmitter",
        "createAttributePayload",
        "diffAttributePayloads",
        "createPublicInstance",
        "ReactFiberErrorDialog",
        "createPublicRootInstance",
        "createPublicTextInstance",
        "getNativeTagFromPublicInstance",
        "getNodeFromPublicInstance",
        "legacySendAccessibilityEvent",
        "UIManager"
      ]
    },
    {
      "file": "src/platform.js",
      "exports": [
        "default"
      ]
    },
    {
      "file": "src/native-modules.js",
      "exports": [
        "default"
      ]
    },
    {
      "file": "src/ui-manager.js",
      "exports": [
        "default"
      ]
    },
    {
      "file": "src/svg.jsx",
      "exports": [
        "G",
        "Path",
        "Rect",
        "Circle",
        "Line",
        "Text",
        "Defs",
        "ClipPath",
        "LinearGradient",
        "Stop",
        "default"
      ]
    },
    {
      "file": "src/react-native-platform.jsx",
      "exports": [
        "useWindowDimensions",
        "Platform",
        "StyleSheet",
        "View",
        "Text",
        "ScrollView",
        "PanResponder",
        "useColorScheme",
        "Dimensions",
        "Appearance",
        "AppState",
        "AccessibilityInfo",
        "PixelRatio",
        "I18nManager",
        "Pressable",
        "Image",
        "Switch",
        "TouchableHighlight",
        "TouchableOpacity",
        "TouchableWithoutFeedback",
        "ActivityIndicator",
        "StatusBar",
        "FlatList",
        "ImageBackground",
        "KeyboardAvoidingView",
        "VirtualizedList",
        "TextInput",
        "Button",
        "AppRegistry",
        "RootTagContext"
      ]
    },
    {
      "file": "tailwind.config.cjs",
      "exports": [
        "content",
        "presets",
        "corePlugins",
        "theme"
      ]
    }
  ],
  "framework": [
    {
      "name": "fabric-godot-build",
      "enablers": [
        "esbuild"
      ],
      "entryPoints": [
        "scripts/*.mjs",
        "tailwind.config.cjs",
        "src/nativewind.css",
        "sdk/toolchain/*.mjs",
        "consumers/minimal/ui/platform.godot.ts"
      ],
      "entryPointRole": "support",
      "toolingDependencies": [
        "@react-native/babel-preset",
        "tailwindcss",
        "@babel/core"
      ],
      "usedExports": [
        {
          "pattern": "types/react-native.ts",
          "exports": [
            "View",
            "Text",
            "TextInput",
            "Button",
            "StyleSheet",
            "AppRegistry",
            "RootTagContext"
          ]
        },
        {
          "pattern": "consumers/minimal/ui/platform.godot.ts",
          "exports": [
            "platformMessage"
          ]
        }
      ]
    }
  ]
}
